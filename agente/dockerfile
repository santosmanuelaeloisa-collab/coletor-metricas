# Usa uma imagem oficial leve do Python
FROM python:3.11-slim

# Cria um usuário sem privilégios (boa prática de segurança exigida)
RUN useradd -m appuser

# Define o diretório de trabalho dentro do contêiner
WORKDIR /app

# Instala as dependências do sistema necessárias para o psutil
RUN apt-get update && apt-get install -y --no-install-recommends gcc && rm -rf /var/lib/apt/lists/*

# Copia e instala as dependências Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia o código do agente para dentro do contêiner
COPY agente.py .

# Muda a propriedade dos arquivos para o usuário não-privilegiado
RUN chown -R appuser:appuser /app

# Alterna para o usuário sem privilégios para executar a aplicação
USER appuser

# Comando para iniciar o agente
CMD ["python", "agente.py"]